DATABASE_URL="file:./prisma/dev.db"

# Admin API key — used for Postman admin endpoints (Authorization: Bearer <key>)
ADMIN_API_KEY="generate-a-strong-secret-here"
NEXTAUTH_SECRET="generate-a-strong-secret-here"
# Tells NextAuth to derive the base URL from the request Host header (works on any port in dev).
# In production, set AUTH_URL=https://yourdomain.com instead.
AUTH_TRUST_HOST=1

# Stripe (for settlement payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# SMTP (for invitation emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
