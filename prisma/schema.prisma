generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  password            String
  role                String               @default("user")
  isActive            Boolean              @default(true)
  sheets              ExpenseSheet[]
  collaborations      SheetCollaborator[]
  comments            TransactionComment[]
  passwordResetTokens PasswordResetToken[]
  impersonationTokens ImpersonationToken[]
  createdAt           DateTime             @default(now())
}

model ExpenseSheet {
  id              String               @id @default(cuid())
  title           String
  ownerId         String
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isCollaborative Boolean              @default(false)
  participants    Participant[]
  transactions    Transaction[]
  collaborators   SheetCollaborator[]
  invitations     SheetInvitation[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model SheetCollaborator {
  id       String       @id @default(cuid())
  sheetId  String
  sheet    ExpenseSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String       @default("collaborator")
  joinedAt DateTime     @default(now())

  @@unique([sheetId, userId])
}

model SheetInvitation {
  id        String       @id @default(cuid())
  token     String       @unique @default(cuid())
  sheetId   String
  sheet     ExpenseSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  phone     String?
  email     String?
  status    String       @default("pending")
  createdAt DateTime     @default(now())
  expiresAt DateTime
}

model Participant {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  sheetId      String
  sheet        ExpenseSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  splits       Split[]
  transactions Transaction[]
}

model Transaction {
  id            String               @id @default(cuid())
  title         String
  amount        Float
  date          DateTime?
  paidById      String
  paidBy        Participant          @relation(fields: [paidById], references: [id])
  sheetId       String
  sheet         ExpenseSheet         @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  createdByUserId String?
  splits        Split[]
  comments      TransactionComment[]
  createdAt     DateTime             @default(now())
}

model TransactionComment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  text          String
  createdAt     DateTime    @default(now())
}

model Split {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  amount        Float
  percentage    Float?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ImpersonationToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  action       String
  targetUserId String
  metadata     String?
  createdAt    DateTime @default(now())
}
